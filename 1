      x.name,x.national,x.location,x.channel,x.type,x.topmark,x.light,x.description
    ].join(' ').toLowerCase();
    return (!q || hay.includes(q))
      && (!channel || x.channel===channel)
      && (!type || x.type===type);
  });

  a.sort((x,y)=>Number(x.no)-Number(y.no));

  document.getElementById('rows').innerHTML=a.map(x=>`
    <tr>
      <td>${esc(x.no)}</td>
      <td><b>${esc(x.national)}</b></td>
      <td>
        <b>${esc(x.name)}</b>
        <div class="small">${esc(x.lat)}<br>${esc(x.lon)}</div>
      </td>
      <td>${esc(x.location)}</td>
      <td>${esc(x.channel)}</td>
      <td><span class="pill">${esc(x.type)}</span></td>
      <td>${esc(x.topmark || '—')}</td>
      <td>
        <b>${esc(x.light || '—')}</b>
        <div class="small">${esc(x.flash || '')}</div>
      </td>
      <td>
        <span class="pill">${esc(x.status || '—')}</span>
        <div class="small">Tahun: ${esc(x.year ?? '—')}<br>Sumber daya: ${esc(x.power || '—')}</div>
      </td>
    </tr>`).join('');

  document.getElementById('count').textContent =
    `Menampilkan ${a.length} dari ${data.length} data`;
}

const yearCounts={};
data.forEach(x=>{
  const key=typeof x.year==='number' ? x.year : '—';
  yearCounts[key]=(yearCounts[key]||0)+1;
});

const timelineYears=Object.keys(yearCounts).sort((a,b)=>{
  if(a==='—') return 1;
  if(b==='—') return -1;
  return Number(a)-Number(b);
});

const maxCount=Math.max(...Object.values(yearCounts));

document.getElementById('timeline').innerHTML=timelineYears.map(year=>{
  const count=yearCounts[year];
  const h=25+110*(count/maxCount);
  const missing=year==='—';

  return `
    <div class="timelineGroup">
      <div class="bar ${missing?'missing':''}" style="height:${h}px"
           title="${missing?'Tahun pembangunan belum tersedia':year+' — '+count+' pelampung suar'}">
        <span>${count}</span>
      </div>
      <div class="yearLabel">${missing?'Belum ada tahun':year}</div>
      <div class="yearCount">${count} pelampung</div>
    </div>`;
}).join('');

render();
</script>
</body>
</html>
