<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Poster Interaktif — Pelampung Suar</title>
<style>
:root{--navy:#0b2940;--blue:#1677a8;--sky:#dff3fb;--sand:#f2eadc;--white:#fff;--ink:#14222d;--muted:#5e6d77;--gold:#e0a43a;}
*{box-sizing:border-box}
body{margin:0;font-family:Inter,Arial,sans-serif;background:#edf4f7;color:var(--ink)}
.wrap{max-width:1180px;margin:auto;padding:20px}
.hero{display:grid;grid-template-columns:1.05fr .95fr;gap:0;background:var(--navy);border-radius:24px;overflow:hidden;box-shadow:0 18px 50px #0b294033}
.hero img{width:100%;height:100%;min-height:430px;object-fit:cover;display:block}
.heroText{padding:44px;color:#fff;display:flex;flex-direction:column;justify-content:center}
.kicker{letter-spacing:.14em;text-transform:uppercase;color:#9bdaf0;font-size:13px;font-weight:800}
h1{font-size:56px;line-height:.95;margin:12px 0 14px}
.heroText p{font-size:18px;line-height:1.55;color:#dbeaf1}
.badge{display:inline-block;background:var(--gold);color:#17222a;padding:9px 13px;border-radius:999px;font-weight:800;margin-top:12px;width:max-content}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:18px 0}
.card{background:#fff;border-radius:18px;padding:18px;box-shadow:0 8px 28px #0b294012}
.num{font-size:34px;font-weight:900;color:var(--blue)}
.label{color:var(--muted);font-size:13px;margin-top:4px}
.section{background:#fff;border-radius:20px;padding:24px;margin:18px 0;box-shadow:0 8px 28px #0b294012}
.section h2{margin:0 0 14px;color:var(--navy)}
.controls{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}
input,select{padding:12px 14px;border:1px solid #d2dde3;border-radius:12px;font-size:14px;background:#fff}
input{min-width:260px;flex:1}
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{padding:11px 9px;border-bottom:1px solid #e5ecef;text-align:left;vertical-align:top}
th{color:var(--navy);background:#f2f7f9;position:sticky;top:0;z-index:2}
tr:hover td{background:#f8fbfc}
.pill{padding:5px 8px;border-radius:999px;background:#e8f5fa;color:#0d607f;font-weight:700;white-space:nowrap}
.small{color:#71808a;font-size:12px;line-height:1.5}
.timeline{display:flex;gap:18px;align-items:flex-end;height:180px;border-bottom:2px solid #b8c9d1;padding:28px 12px 0;overflow-x:auto}
.timelineGroup{flex:1;min-width:72px;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;position:relative}
.bar{width:42px;background:linear-gradient(#1a8bb8,#0b5577);border-radius:8px 8px 0 0;min-height:10px;position:relative}
.bar span{position:absolute;top:-22px;font-size:11px;font-weight:800;color:var(--muted);left:50%;transform:translateX(-50%);white-space:nowrap}
.yearLabel{font-size:11px;font-weight:700;color:var(--navy);margin-top:7px;white-space:nowrap}
.yearCount{font-size:10px;color:var(--muted);margin-top:2px;white-space:nowrap}
.bar.missing{background:#b8c9d1}
.footer{text-align:center;color:var(--muted);font-size:12px;padding:14px}
.count{margin-left:auto;color:var(--muted);font-size:13px;padding:12px 0}
@media(max-width:800px){
 .hero{grid-template-columns:1fr}
 .hero img{min-height:300px;max-height:420px}
 h1{font-size:42px}
 .stats{grid-template-columns:repeat(2,1fr)}
 .section{overflow:auto}
 .controls{align-items:stretch}
 input,select{min-width:100%}
 .count{margin-left:0}
}
</style>
</head>
